# Build-time site selector (server alias). NEXT_PUBLIC_SITE_ID must carry the
# same value — it is inlined into the client bundle for chrome strings.
SITE_ID=com
NEXT_PUBLIC_SITE_ID=com
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
# Required for private/staging datasets and when project access control
# restricts anonymous reads. Viewer role is sufficient.
SANITY_READ_TOKEN=
